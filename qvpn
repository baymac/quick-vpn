# ─── teardown ────────────────────────────────────────────────────────────────
cmd_teardown_help() {
    cat <<EOF
Usage: qvpn teardown [options]

Stop the WireGuard service and remove all configuration.

By default this is a soft teardown: it does NOT uninstall packages or disable
IP forwarding. Use --purge for a full uninstall.

Options:
  -y, --yes              Skip confirmation prompt
      --purge            Also uninstall packages and disable IP forwarding
      --keep-packages    (default) Don't remove packages
      --keep-forwarding  (default) Don't disable sysctl IP forwarding
EOF
}

cmd_teardown() {
    local keep_packages=1 keep_forwarding=1
    while (( $# )); do
        case "$1" in
            -y|--yes)         ASSUME_YES=1; shift ;;
            --purge)          keep_packages=0; keep_forwarding=0; shift ;;
            --keep-packages)  keep_packages=1; shift ;;
            --keep-forwarding) keep_forwarding=1; shift ;;
            -h|--help)        cmd_teardown_help; exit 0 ;;
            *)                die "Unknown option: $1" "Run: qvpn help teardown" ;;
        esac
    done

    require_root teardown

    local fwd_line pkg_line
    if (( keep_forwarding )); then
        fwd_line="${C_DIM}• IP forwarding: kept (use --purge to disable)${C_RESET}"
    else
        fwd_line="• Disable IP forwarding (sysctl)"
    fi
    if (( keep_packages )); then
        pkg_line="${C_DIM}• Packages: kept (use --purge to uninstall)${C_RESET}"
    else
        pkg_line="• Uninstall: wireguard, qrencode"
    fi

    banner "WireGuard teardown"
    cat <<EOF
  This will:
    • Stop and disable wg-quick@${WG_INTERFACE}
    • Delete ${WG_DIR}/ (server + client keys, configs, QR codes)
    • Remove UFW rule for the listen port
    • Flush WireGuard iptables rules
    ${fwd_line}
    ${pkg_line}

  ${C_RED}${C_BOLD}This cannot be undone.${C_RESET}

EOF
    confirm "Proceed with teardown?" "n" || die "Aborted by user."

    # Read listen port from existing config (so we can clean up firewall) BEFORE deleting it.
    local listen_port=""
    [[ -f "$WG_CONF" ]] && listen_port=$(awk '/^[[:space:]]*ListenPort/ {sub(/^[^=]*=[[:space:]]*/,""); print; exit}' "$WG_CONF")
    [[ -z "$listen_port" ]] && [[ -f "$QVPN_META" ]] && { . "$QVPN_META"; listen_port="$LISTEN_PORT"; }
    listen_port="${listen_port:-${DEFAULT_LISTEN_PORT}}"

    log "Stopping service..."
    if systemctl is-active --quiet "wg-quick@${WG_INTERFACE}" 2>/dev/null; then
        run systemctl stop "wg-quick@${WG_INTERFACE}" || true
    fi
    if systemctl is-enabled --quiet "wg-quick@${WG_INTERFACE}" 2>/dev/null; then
        run systemctl disable "wg-quick@${WG_INTERFACE}" 2>/dev/null || true
    fi

    if ip link show "$WG_INTERFACE" >/dev/null 2>&1; then
        run ip link delete "$WG_INTERFACE" || true
    fi

    log "Removing configuration..."
    if [[ -d "$WG_DIR" ]]; then
        run rm -rf "$WG_DIR"
        ok "Removed $WG_DIR"
    else
        warn "Nothing at $WG_DIR — already clean."
    fi

    log "Cleaning firewall rules..."
    if command -v ufw >/dev/null 2>&1; then
        run ufw --force delete allow "${listen_port}/udp" 2>/dev/null || true
    fi
    iptables -D FORWARD -i "$WG_INTERFACE" -j ACCEPT 2>/dev/null || true
    for iface in eth0 ens3 ens4 ens5 enp0s3 enp0s8; do
        iptables -t nat -D POSTROUTING -o "$iface" -j MASQUERADE 2>/dev/null || true
    done

    if (( ! keep_forwarding )); then
        log "Disabling IP forwarding..."
        run rm -f /etc/sysctl.d/99-qvpn-wireguard.conf
        sed -i '/^net\.ipv4\.ip_forward=1/d'              /etc/sysctl.conf 2>/dev/null || true
        sed -i '/^net\.ipv6\.conf\.all\.forwarding=1/d'   /etc/sysctl.conf 2>/dev/null || true
        echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null || true
        echo 0 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || true
    fi

    if (( ! keep_packages )); then
        log "Uninstalling packages..."
        if command -v apt-get >/dev/null 2>&1; then
            run apt-get remove --purge -y wireguard qrencode 2>/dev/null || true
            run apt-get autoremove -y 2>/dev/null || true
        elif command -v dnf >/dev/null 2>&1; then
            run dnf remove -y wireguard-tools qrencode 2>/dev/null || true
        elif command -v pacman >/dev/null 2>&1; then
            run pacman -Rns --noconfirm wireguard-tools qrencode 2>/dev/null || true
        fi
    fi

    ok "Teardown complete."
}

# ─── version ─────────────────────────────────────────────────────────────────
cmd_version() {
    printf 'qvpn %s\n' "$QVPN_VERSION"
}

# ─── help ────────────────────────────────────────────────────────────────────
cmd_help() {
    if [[ -n "${1:-}" ]]; then
        case "$1" in
            init)     cmd_init_help ;;
            add)      cmd_add_help ;;
            remove|rm) cmd_remove_help ;;
            list|ls)  cmd_list_help ;;
            show)     cmd_show_help ;;
            status)   cmd_status_help ;;
            restart)  cmd_restart_help ;;
            teardown) cmd_teardown_help ;;
            *)        err "Unknown command: $1"; cmd_help; exit 1 ;;
        esac
        return 0
    fi
    cat <<EOF
${C_BOLD}qvpn ${QVPN_VERSION}${C_RESET} — quick WireGuard VPN for your VPS

${C_BOLD}USAGE${C_RESET}
  qvpn <command> [options]

${C_BOLD}COMMANDS${C_RESET}
  ${C_GREEN}init${C_RESET}          set up WireGuard and create the first client
  ${C_GREEN}add${C_RESET} <name>    add a new client (auto-assigns IP if not given)
  ${C_GREEN}remove${C_RESET} <name> revoke a client and delete its files
  ${C_GREEN}list${C_RESET}          list all clients
  ${C_GREEN}show${C_RESET} <name>   re-display QR + config for a client
  ${C_GREEN}status${C_RESET}        show service health and connected peers
  ${C_GREEN}restart${C_RESET}       restart the WireGuard service
  ${C_GREEN}teardown${C_RESET}      stop the service and remove all config
  ${C_GREEN}version${C_RESET}       print qvpn version
  ${C_GREEN}help${C_RESET} [cmd]    show help (optionally for a specific command)

${C_BOLD}GLOBAL OPTIONS${C_RESET}
  -y, --yes              skip confirmation prompts
  -q, --quiet            suppress informational output
  -v, --verbose          show debug output
      --dry-run          print actions without executing
      --no-color         disable colored output  (also: NO_COLOR=1)
      --color WHEN       always | never | auto    (default: auto)
  -c, --config FILE      use this config file
  -V, --version          print version and exit
  -h, --help             show this help

${C_BOLD}EXAMPLES${C_RESET}
  ${C_DIM}# First-time setup with defaults${C_RESET}
  sudo qvpn init

  ${C_DIM}# Custom listen port + first client name${C_RESET}
  sudo qvpn init --name laptop --listen-port 41820

  ${C_DIM}# Add a phone, auto-assign IP${C_RESET}
  sudo qvpn add phone

  ${C_DIM}# Add with explicit IP${C_RESET}
  sudo qvpn add tv --ip 10.0.0.42

  ${C_DIM}# See who's connected${C_RESET}
  sudo qvpn status

  ${C_DIM}# Revoke a client${C_RESET}
  sudo qvpn remove phone

${C_BOLD}LEARN MORE${C_RESET}
  ${QVPN_REPO}
EOF
}

# ============================================================================
#  Main dispatcher
# ============================================================================
main() {
    # Pull global flags out first (anywhere on the line, before/after subcommand)
    local -a passthrough=()
    local cmd=""
    while (( $# )); do
        case "$1" in
            -y|--yes)         ASSUME_YES=1; shift ;;
            -q|--quiet)       QUIET=1; shift ;;
            -v|--verbose)     VERBOSE=1; shift ;;
            --dry-run)        DRY_RUN=1; shift ;;
            --no-color)       COLOR_MODE="never"; shift ;;
            --color)          COLOR_MODE="${2:-auto}"; shift 2 ;;
            --color=*)        COLOR_MODE="${1#*=}"; shift ;;
            -V|--version)     COLOR_MODE="never"; init_colors; cmd_version; exit 0 ;;
            -h|--help)        if [[ -z "$cmd" ]]; then init_colors; cmd_help; exit 0; else passthrough+=("$1"); shift; fi ;;
            -c|--config)      QVPN_CONFIG="$2"; shift 2 ;;
            --config=*)       QVPN_CONFIG="${1#*=}"; shift ;;
            -*)
                # Unknown global flag — pass to subcommand
                passthrough+=("$1"); shift ;;
            *)
                if [[ -z "$cmd" ]]; then
                    cmd="$1"; shift
                else
                    passthrough+=("$1"); shift
                fi
                ;;
        esac
    done

    init_colors

    if [[ -z "$cmd" ]]; then
        cmd_help
        exit 0
    fi

    case "$cmd" in
        init)            cmd_init       "${passthrough[@]}" ;;
        add)             cmd_add        "${passthrough[@]}" ;;
        remove|rm|del)   cmd_remove     "${passthrough[@]}" ;;
        list|ls)         cmd_list       "${passthrough[@]}" ;;
        show|get)        cmd_show       "${passthrough[@]}" ;;
        status|st)       cmd_status     "${passthrough[@]}" ;;
        restart)         cmd_restart    "${passthrough[@]}" ;;
        teardown|destroy|nuke) cmd_teardown "${passthrough[@]}" ;;
        version)         cmd_version ;;
        help|-h|--help)  cmd_help       "${passthrough[@]:-}" ;;
        *)               err "Unknown command: $cmd"; hint "Run: qvpn help"; exit 1 ;;
    esac
}

main "$@"
