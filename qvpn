#!/usr/bin/env bash
#
# qvpn — Quick VPN: a friendly WireGuard CLI for self-hosted VPNs.
#
# https://github.com/baymac/quick-vpn
#
# Run `qvpn help` for usage.

set -eo pipefail

readonly QVPN_VERSION="1.0.0"
readonly QVPN_REPO="https://github.com/baymac/quick-vpn"

# ─── Paths ───────────────────────────────────────────────────────────────────
WG_DIR="${QVPN_WG_DIR:-/etc/wireguard}"
WG_INTERFACE="${QVPN_INTERFACE:-wg0}"
WG_CONF="${WG_DIR}/${WG_INTERFACE}.conf"
CLIENTS_DIR="${WG_DIR}/clients"
QVPN_CONFIG_DEFAULT="${WG_DIR}/qvpn.conf"
QVPN_CONFIG=""                      # set by --config or auto-located
QVPN_META="${WG_DIR}/.qvpn-meta"

# ─── Defaults (overridable via config file or flags) ─────────────────────────
DEFAULT_CLIENT_NAME="phone"
DEFAULT_VPN_SUBNET="10.0.0.0/24"
DEFAULT_SERVER_VPN_IP="10.0.0.1"
DEFAULT_LISTEN_PORT="51820"
DEFAULT_DNS_SERVERS="1.1.1.1, 8.8.8.8"
DEFAULT_KEEPALIVE="25"
DEFAULT_ALLOWED_IPS="0.0.0.0/0, ::/0"

# Resolved config (init/add fill these in)
CLIENT_NAME=""
CLIENT_VPN_IP=""
VPN_SUBNET=""
SERVER_VPN_IP=""
LISTEN_PORT=""
DNS_SERVERS=""
SERVER_IP=""
NETWORK_INTERFACE=""

# ─── Globals ─────────────────────────────────────────────────────────────────
ASSUME_YES=0
QUIET=0
VERBOSE=0
DRY_RUN=0
COLOR_MODE="auto"

# ─── Output helpers ──────────────────────────────────────────────────────────
init_colors() {
    local enable=0
    case "$COLOR_MODE" in
        always) enable=1 ;;
        never)  enable=0 ;;
        *)
            if [[ -z "${NO_COLOR:-}" ]] && [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]; then
                enable=1
            fi
            ;;
    esac

    if [[ $enable == 1 ]]; then
        C_RED=$'\033[0;31m'
        C_GREEN=$'\033[0;32m'
        C_YELLOW=$'\033[1;33m'
        C_BLUE=$'\033[0;34m'
        C_CYAN=$'\033[0;36m'
        C_MAGENTA=$'\033[0;35m'
        C_BOLD=$'\033[1m'
        C_DIM=$'\033[2m'
        C_RESET=$'\033[0m'
    else
        C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_CYAN="" C_MAGENTA=""
        C_BOLD="" C_DIM="" C_RESET=""
    fi

    if [[ "${LANG:-}${LC_ALL:-}" =~ UTF-?8 ]]; then
        SYM_OK="✓"; SYM_ERR="✗"; SYM_WARN="!"; SYM_INFO="·"; SYM_ARROW="→"
    else
        SYM_OK="[OK]"; SYM_ERR="[ER]"; SYM_WARN="[!]"; SYM_INFO="[i]"; SYM_ARROW="->"
    fi
}

log()   { (( QUIET )) || printf '%s%s%s %s\n' "$C_CYAN"   "$SYM_INFO"  "$C_RESET" "$*"; }
ok()    { (( QUIET )) || printf '%s%s%s %s\n' "$C_GREEN"  "$SYM_OK"    "$C_RESET" "$*"; }
warn()  { printf '%s%s%s %s\n' "$C_YELLOW" "$SYM_WARN" "$C_RESET" "$*" >&2; }
err()   { printf '%s%s%s %s\n' "$C_RED"    "$SYM_ERR"  "$C_RESET" "$*" >&2; }
hint()  { printf '%s    %s %s%s\n' "$C_DIM" "$SYM_ARROW" "$*" "$C_RESET" >&2; }
debug() { (( VERBOSE )) && printf '%s[debug]%s %s\n' "$C_DIM" "$C_RESET" "$*" >&2 || true; }

die() {
    err "$1"
    [[ -n "${2:-}" ]] && hint "$2"
    exit "${3:-1}"
}

section() {
    printf '\n%s── %s ──%s\n\n' "$C_BOLD" "$1" "$C_RESET"
}

banner() {
    local text="$1"
    local len=${#text}
    local pad=2
    local total=$((len + pad * 2))
    local rule
    printf -v rule '%*s' "$total" ''
    rule="${rule// /━}"
    printf '\n%s%s%s\n' "$C_BOLD" "$rule" "$C_RESET"
    printf '%s%*s%s%*s%s\n' "$C_BOLD" $pad '' "$text" $pad '' "$C_RESET"
    printf '%s%s%s\n\n' "$C_BOLD" "$rule" "$C_RESET"
}

# ─── Prompts / runners ───────────────────────────────────────────────────────
confirm() {
    local prompt="${1:-Continue?}" default="${2:-n}" reply
    if (( ASSUME_YES )); then
        debug "auto-confirm: $prompt"
        return 0
    fi
    if [[ "$default" == "y" ]]; then
        printf '%s%s [Y/n]: %s' "$C_BOLD" "$prompt" "$C_RESET"
    else
        printf '%s%s [y/N]: %s' "$C_BOLD" "$prompt" "$C_RESET"
    fi
    read -r reply || reply=""
    [[ -z "$reply" ]] && reply="$default"
    [[ "$reply" =~ ^[Yy]$ ]]
}

run() {
    if (( DRY_RUN )); then
        printf '%s[dry-run]%s %s\n' "$C_MAGENTA" "$C_RESET" "$*"
        return 0
    fi
    debug "exec: $*"
    "$@"
}

# ─── Validation / detection ──────────────────────────────────────────────────
require_root() {
    if (( EUID != 0 )); then
        die "qvpn must be run as root." "Try: sudo qvpn $*"
    fi
}

require_cmd() {
    local cmd="$1" hint_msg="${2:-}"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        if [[ -n "$hint_msg" ]]; then
            die "Required command missing: $cmd" "$hint_msg"
        else
            die "Required command missing: $cmd"
        fi
    fi
}

require_wg_running() {
    if ! systemctl is-active --quiet "wg-quick@${WG_INTERFACE}"; then
        die "WireGuard service (wg-quick@${WG_INTERFACE}) is not running." \
            "Start it with: qvpn restart    or run: qvpn init"
    fi
}

require_setup() {
    if [[ ! -f "$WG_CONF" ]]; then
        die "WireGuard is not set up yet (no ${WG_CONF})." "Run: qvpn init"
    fi
}

detect_distro() {
    if [[ -f /etc/os-release ]]; then
        # shellcheck source=/dev/null
        . /etc/os-release
        DISTRO_ID="${ID:-unknown}"
        DISTRO_LIKE="${ID_LIKE:-}"
    else
        DISTRO_ID="unknown"
        DISTRO_LIKE=""
    fi
    debug "distro: $DISTRO_ID (like: $DISTRO_LIKE)"
}

detect_public_ip() {
    local ip=""
    for endpoint in https://api.ipify.org https://ifconfig.me https://icanhazip.com; do
        ip=$(curl -fsS --max-time 5 -4 "$endpoint" 2>/dev/null | tr -d '[:space:]') || ip=""
        if [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "$ip"
            return 0
        fi
    done
    return 1
}

detect_default_iface() {
    ip route 2>/dev/null | awk '/^default/ {print $5; exit}'
}

# ─── Config + state ──────────────────────────────────────────────────────────
locate_config() {
    if [[ -n "$QVPN_CONFIG" ]]; then
        [[ -f "$QVPN_CONFIG" ]] || die "Config file not found: $QVPN_CONFIG"
        return 0
    fi
    # Auto-locate: cwd → /etc/wireguard
    if [[ -f "./qvpn.conf" ]]; then
        QVPN_CONFIG="$(cd "$(dirname "./qvpn.conf")" && pwd)/qvpn.conf"
    elif [[ -f "$QVPN_CONFIG_DEFAULT" ]]; then
        QVPN_CONFIG="$QVPN_CONFIG_DEFAULT"
    fi
}

load_config() {
    locate_config
    if [[ -n "$QVPN_CONFIG" ]]; then
        debug "loading config: $QVPN_CONFIG"
        # shellcheck source=/dev/null
        source "$QVPN_CONFIG"
    fi
    CLIENT_NAME="${CLIENT_NAME:-$DEFAULT_CLIENT_NAME}"
    VPN_SUBNET="${VPN_SUBNET:-$DEFAULT_VPN_SUBNET}"
    SERVER_VPN_IP="${SERVER_VPN_IP:-$DEFAULT_SERVER_VPN_IP}"
    LISTEN_PORT="${LISTEN_PORT:-$DEFAULT_LISTEN_PORT}"
    DNS_SERVERS="${DNS_SERVERS:-$DEFAULT_DNS_SERVERS}"
}

load_meta() {
    if [[ -f "$QVPN_META" ]]; then
        # shellcheck source=/dev/null
        source "$QVPN_META"
        debug "loaded state: $QVPN_META"
    fi
}

save_meta() {
    cat > "$QVPN_META" <<EOF
# qvpn state — written by qvpn ${QVPN_VERSION}. Safe to delete (will be regenerated).
QVPN_VERSION="${QVPN_VERSION}"
SERVER_IP="${SERVER_IP}"
VPN_SUBNET="${VPN_SUBNET}"
SERVER_VPN_IP="${SERVER_VPN_IP}"
LISTEN_PORT="${LISTEN_PORT}"
DNS_SERVERS="${DNS_SERVERS}"
NETWORK_INTERFACE="${NETWORK_INTERFACE}"
EOF
    chmod 600 "$QVPN_META"
}

# ─── IP / subnet helpers ─────────────────────────────────────────────────────
subnet_prefix() {
    # 10.0.0.0/24  →  10.0.0
    local subnet="$1"
    echo "${subnet%.*/*}"
}

next_free_ip() {
    local prefix used ip
    prefix=$(subnet_prefix "$VPN_SUBNET")

    # Collect all in-use IPs from server config + client configs.
    used=$(
        {
            grep -hE '^(Address|AllowedIPs)' "$WG_CONF" 2>/dev/null \
                | sed -E 's/^[^=]*=[[:space:]]*//; s/,.*//; s/\/.*//'
            if [[ -d "$CLIENTS_DIR" ]]; then
                grep -hE '^Address' "$CLIENTS_DIR"/*.conf 2>/dev/null \
                    | sed -E 's/^[^=]*=[[:space:]]*//; s/\/.*//'
            fi
            echo "$SERVER_VPN_IP"
        } | sort -u
    )

    for octet in $(seq 2 254); do
        ip="${prefix}.${octet}"
        if ! grep -qx "$ip" <<<"$used"; then
            echo "$ip"
            return 0
        fi
    done
    return 1
}

ip_in_use() {
    local ip="$1"
    if grep -hE '^(Address|AllowedIPs)' "$WG_CONF" 2>/dev/null \
        | sed -E 's/^[^=]*=[[:space:]]*//; s/,.*//; s/\/.*//' \
        | grep -qx "$ip"; then
        return 0
    fi
    if [[ -d "$CLIENTS_DIR" ]]; then
        if grep -hE '^Address' "$CLIENTS_DIR"/*.conf 2>/dev/null \
            | sed -E 's/^[^=]*=[[:space:]]*//; s/\/.*//' \
            | grep -qx "$ip"; then
            return 0
        fi
    fi
    return 1
}

valid_client_name() {
    [[ "$1" =~ ^[A-Za-z0-9._-]{1,32}$ ]]
}

# ─── Dependency installation ─────────────────────────────────────────────────
install_packages() {
    local pkgs=(wireguard qrencode ufw)
    log "Installing packages: ${pkgs[*]}"
    case "$DISTRO_ID${DISTRO_LIKE}" in
        *debian*|*ubuntu*)
            run apt-get update -qq
            run apt-get install -y -qq "${pkgs[@]}"
            ;;
        *fedora*|*rhel*|*centos*)
            run dnf install -y wireguard-tools qrencode firewalld
            ;;
        *arch*)
            run pacman -S --noconfirm wireguard-tools qrencode ufw
            ;;
        *)
            warn "Unrecognized distro: ${DISTRO_ID}. Install these manually: ${pkgs[*]}"
            ;;
    esac
}

# ─── Server-config peer parsing ──────────────────────────────────────────────
# Outputs lines: <pubkey>\t<allowed-ip>
# Note: WireGuard base64 keys end in '=', so we use ^[^=]*= (up-to-first-equals)
# rather than .*= (greedy) to avoid eating trailing '=' from values.
list_server_peers() {
    [[ -f "$WG_CONF" ]] || return 0
    awk '
        /^\[Peer\]/ {
            if (in_peer && pk!="" && aip!="") print pk "\t" aip
            in_peer=1; pk=""; aip=""; next
        }
        /^\[/ {
            if (in_peer && pk!="" && aip!="") print pk "\t" aip
            in_peer=0; next
        }
        in_peer && /^[[:space:]]*PublicKey/  { sub(/^[^=]*=[[:space:]]*/,""); pk=$0 }
        in_peer && /^[[:space:]]*AllowedIPs/ { sub(/^[^=]*=[[:space:]]*/,""); sub(/\/.*/,""); sub(/,.*/,""); aip=$0 }
        END { if (in_peer && pk!="" && aip!="") print pk "\t" aip }
    ' "$WG_CONF"
}

# Map a client config file to its derived public key and IP.
client_pubkey() {
    local conf="$1" pk priv
    priv=$(awk '/^[[:space:]]*PrivateKey/ {sub(/^[^=]*=[[:space:]]*/,""); print; exit}' "$conf")
    [[ -z "$priv" ]] && return 1
    pk=$(echo "$priv" | wg pubkey 2>/dev/null) || return 1
    echo "$pk"
}

client_ip_from_conf() {
    local conf="$1"
    awk '/^[[:space:]]*Address/ {sub(/^[^=]*=[[:space:]]*/,""); sub(/\/.*/,""); print; exit}' "$conf"
}

# ─── QR / config display ─────────────────────────────────────────────────────
show_client_payload() {
    local conf="$1" name="$2"
    if ! command -v qrencode >/dev/null 2>&1; then
        warn "qrencode not installed — skipping QR code."
    else
        section "Scan with the WireGuard mobile app"
        qrencode -t ansiutf8 < "$conf"
    fi
    section "Or paste this config into WireGuard (desktop / manual)"
    printf '%s%s%s\n' "$C_DIM" "─────────────────────────────────────" "$C_RESET"
    cat "$conf"
    printf '%s%s%s\n\n' "$C_DIM" "─────────────────────────────────────" "$C_RESET"

    local png="${CLIENTS_DIR}/${name}_qr.png"
    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t png -o "$png" < "$conf"
        ok "QR code (PNG) saved → $png"
    fi
}

# ============================================================================
#  Commands
# ============================================================================

# ─── init ────────────────────────────────────────────────────────────────────
cmd_init_help() {
    cat <<EOF
Usage: qvpn init [options]

Set up WireGuard on this server and create the first client.

Options:
  -n, --name NAME        First client name             (default: phone)
  -s, --subnet CIDR      VPN subnet                    (default: 10.0.0.0/24)
      --server-ip IP     Public server IP              (default: auto-detect)
      --listen-port PORT UDP listen port               (default: 51820)
      --interface IFACE  Host network interface        (default: auto-detect)
      --dns SERVERS      Client DNS servers (comma-sep) (default: 1.1.1.1, 8.8.8.8)
  -c, --config FILE      Read config from FILE
  -y, --yes              Don't prompt for confirmation

If a config file is found at ./qvpn.conf or /etc/wireguard/qvpn.conf,
its values are used unless overridden by flags.
EOF
}

cmd_init() {
    local force=0
    while (( $# )); do
        case "$1" in
            -n|--name)         CLIENT_NAME="$2"; shift 2 ;;
            -s|--subnet)       VPN_SUBNET="$2"; shift 2 ;;
            --server-ip)       SERVER_IP="$2"; shift 2 ;;
            --listen-port)     LISTEN_PORT="$2"; shift 2 ;;
            --interface)       NETWORK_INTERFACE="$2"; shift 2 ;;
            --dns)             DNS_SERVERS="$2"; shift 2 ;;
            -c|--config)       QVPN_CONFIG="$2"; shift 2 ;;
            -y|--yes)          ASSUME_YES=1; shift ;;
            -f|--force)        force=1; shift ;;
            -h|--help)         cmd_init_help; exit 0 ;;
            *)                 die "Unknown option: $1" "Run: qvpn help init" ;;
        esac
    done

    require_root init
    detect_distro
    load_config

    valid_client_name "$CLIENT_NAME" \
        || die "Invalid client name: $CLIENT_NAME" "Use letters, digits, dot, dash, underscore (≤32 chars)."

    # Existing setup → offer teardown
    if [[ -f "$WG_CONF" ]] || systemctl is-active --quiet "wg-quick@${WG_INTERFACE}" 2>/dev/null; then
        warn "An existing WireGuard configuration was detected at $WG_CONF."
        if (( ! force )); then
            confirm "Tear down the existing setup and start fresh?" "n" \
                || die "Aborted by user." "Tip: pass --force to replace without prompting."
        fi
        cmd_teardown --keep-packages --keep-forwarding --yes
    fi

    if [[ -z "$SERVER_IP" ]]; then
        log "Detecting public IP..."
        SERVER_IP=$(detect_public_ip) \
            || die "Could not auto-detect public IP." "Pass it explicitly with --server-ip <ip>."
        ok "Detected public IP: $SERVER_IP"
    fi

    if [[ -z "$NETWORK_INTERFACE" ]]; then
        NETWORK_INTERFACE=$(detect_default_iface || true)
        if [[ -z "$NETWORK_INTERFACE" ]]; then
            warn "Could not detect default network interface. Falling back to eth0."
            NETWORK_INTERFACE="eth0"
        else
            ok "Detected default interface: $NETWORK_INTERFACE"
        fi
    fi

    # Default first client IP = first usable in subnet (server is .1, so client is .2)
    if [[ -z "$CLIENT_VPN_IP" ]]; then
        CLIENT_VPN_IP="$(subnet_prefix "$VPN_SUBNET").2"
    fi

    banner "Quick VPN — initializing WireGuard"
    cat <<EOF
  ${C_BOLD}Server:${C_RESET}     ${SERVER_IP}:${LISTEN_PORT}/udp
  ${C_BOLD}Subnet:${C_RESET}     ${VPN_SUBNET}
  ${C_BOLD}Server VPN:${C_RESET} ${SERVER_VPN_IP}
  ${C_BOLD}Interface:${C_RESET}  ${NETWORK_INTERFACE} (host)  ↔  ${WG_INTERFACE} (vpn)
  ${C_BOLD}First client:${C_RESET} ${CLIENT_NAME} → ${CLIENT_VPN_IP}
  ${C_BOLD}DNS:${C_RESET}        ${DNS_SERVERS}

EOF
    confirm "Proceed with this configuration?" "y" || die "Aborted by user."

    install_packages

    section "Enabling IP forwarding"
    local sysctl_file="/etc/sysctl.d/99-qvpn-wireguard.conf"
    cat > "$sysctl_file" <<EOF
# Managed by qvpn — IP forwarding for WireGuard
net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=1
EOF
    run sysctl -q -p "$sysctl_file"
    ok "IP forwarding enabled (persisted in $sysctl_file)"

    section "Generating keys"
    mkdir -p "$WG_DIR" "$CLIENTS_DIR"
    chmod 700 "$WG_DIR" "$CLIENTS_DIR"

    umask 077
    local server_priv server_pub client_priv client_pub
    server_priv=$(wg genkey)
    server_pub=$(echo "$server_priv" | wg pubkey)
    client_priv=$(wg genkey)
    client_pub=$(echo "$client_priv" | wg pubkey)
    echo "$server_priv" > "$WG_DIR/privatekey"; chmod 600 "$WG_DIR/privatekey"
    echo "$server_pub"  > "$WG_DIR/publickey";  chmod 644 "$WG_DIR/publickey"
    echo "$client_priv" > "$CLIENTS_DIR/${CLIENT_NAME}_privatekey"; chmod 600 "$CLIENTS_DIR/${CLIENT_NAME}_privatekey"
    echo "$client_pub"  > "$CLIENTS_DIR/${CLIENT_NAME}_publickey";  chmod 644 "$CLIENTS_DIR/${CLIENT_NAME}_publickey"
    ok "Server and client keys generated"

    section "Writing configuration"
    cat > "$WG_CONF" <<EOF
[Interface]
PrivateKey = ${server_priv}
Address = ${SERVER_VPN_IP}/24
ListenPort = ${LISTEN_PORT}
PostUp = iptables -A FORWARD -i ${WG_INTERFACE} -j ACCEPT; iptables -t nat -A POSTROUTING -o ${NETWORK_INTERFACE} -j MASQUERADE
PostDown = iptables -D FORWARD -i ${WG_INTERFACE} -j ACCEPT; iptables -t nat -D POSTROUTING -o ${NETWORK_INTERFACE} -j MASQUERADE
SaveConfig = true

# Client: ${CLIENT_NAME}
[Peer]
PublicKey = ${client_pub}
AllowedIPs = ${CLIENT_VPN_IP}/32
EOF
    chmod 600 "$WG_CONF"

    cat > "$CLIENTS_DIR/${CLIENT_NAME}.conf" <<EOF
[Interface]
PrivateKey = ${client_priv}
Address = ${CLIENT_VPN_IP}/24
DNS = ${DNS_SERVERS}

[Peer]
PublicKey = ${server_pub}
Endpoint = ${SERVER_IP}:${LISTEN_PORT}
AllowedIPs = ${DEFAULT_ALLOWED_IPS}
PersistentKeepalive = ${DEFAULT_KEEPALIVE}
EOF
    chmod 600 "$CLIENTS_DIR/${CLIENT_NAME}.conf"
    ok "Server config:  $WG_CONF"
    ok "Client config:  $CLIENTS_DIR/${CLIENT_NAME}.conf"

    save_meta

    section "Configuring firewall"
    if command -v ufw >/dev/null 2>&1; then
        run ufw allow ssh >/dev/null
        run ufw allow "${LISTEN_PORT}/udp" >/dev/null
        if ! ufw status | grep -q "Status: active"; then
            warn "UFW is not active. Enabling now (will allow SSH + ${LISTEN_PORT}/udp)."
            run ufw --force enable >/dev/null
        fi
        ok "UFW: SSH and ${LISTEN_PORT}/udp allowed"
    else
        warn "ufw not found — skipping firewall configuration."
        hint "Make sure ${LISTEN_PORT}/udp is reachable from the public internet."
    fi

    section "Starting WireGuard service"
    run systemctl enable --now "wg-quick@${WG_INTERFACE}" 2>/dev/null
    if systemctl is-active --quiet "wg-quick@${WG_INTERFACE}"; then
        ok "wg-quick@${WG_INTERFACE} is running"
    else
        err "wg-quick@${WG_INTERFACE} failed to start"
        systemctl --no-pager status "wg-quick@${WG_INTERFACE}" || true
        exit 1
    fi

    section "Client setup — '${CLIENT_NAME}'"
    show_client_payload "$CLIENTS_DIR/${CLIENT_NAME}.conf" "$CLIENT_NAME"

    banner "✓ VPN ready"
    cat <<EOF
  ${C_BOLD}Endpoint:${C_RESET}    ${SERVER_IP}:${LISTEN_PORT}/udp
  ${C_BOLD}Server VPN:${C_RESET}  ${SERVER_VPN_IP}
  ${C_BOLD}Client VPN:${C_RESET}  ${CLIENT_VPN_IP}

  Next steps:
    ${C_DIM}qvpn add laptop${C_RESET}                 add another client
    ${C_DIM}qvpn list${C_RESET}                       see all clients
    ${C_DIM}qvpn status${C_RESET}                     show connection state
    ${C_DIM}qvpn show ${CLIENT_NAME}${C_RESET}              re-display QR / config

EOF
}

# ─── add ─────────────────────────────────────────────────────────────────────
cmd_add_help() {
    cat <<EOF
Usage: qvpn add <name> [options]

Add a new client to the running WireGuard server.

Options:
      --ip IP            VPN IP for client      (default: next free in subnet)
      --dns SERVERS      Client DNS (comma-sep) (default: from server state)
  -c, --config FILE      Read overrides from FILE
  -y, --yes              Skip confirmation prompts

Examples:
  qvpn add laptop
  qvpn add tv --ip 10.0.0.42
EOF
}

cmd_add() {
    local name="" custom_ip="" custom_dns=""
    while (( $# )); do
        case "$1" in
            --ip)         custom_ip="$2"; shift 2 ;;
            --dns)        custom_dns="$2"; shift 2 ;;
            -c|--config)  QVPN_CONFIG="$2"; shift 2 ;;
            -y|--yes)     ASSUME_YES=1; shift ;;
            -h|--help)    cmd_add_help; exit 0 ;;
            -*)           die "Unknown option: $1" "Run: qvpn help add" ;;
            *)            [[ -z "$name" ]] && name="$1" || die "Unexpected argument: $1"; shift ;;
        esac
    done

    [[ -z "$name" ]] && die "Client name required." "Run: qvpn help add"
    valid_client_name "$name" \
        || die "Invalid client name: $name" "Use letters, digits, dot, dash, underscore (≤32 chars)."

    require_root "add $name"
    require_setup
    require_cmd wg
    require_wg_running

    load_meta
    load_config

    # Apply overrides
    [[ -n "$custom_dns" ]] && DNS_SERVERS="$custom_dns"

    if [[ -f "${CLIENTS_DIR}/${name}.conf" ]]; then
        die "A client named '$name' already exists." \
            "Pick a different name, or run: qvpn remove $name"
    fi

    # Determine IP
    if [[ -n "$custom_ip" ]]; then
        if ip_in_use "$custom_ip"; then
            die "IP $custom_ip is already in use." "Try: qvpn add $name --ip <free ip>   or omit --ip for auto-assign."
        fi
        CLIENT_VPN_IP="$custom_ip"
    else
        CLIENT_VPN_IP=$(next_free_ip) || die "No free IPs available in $VPN_SUBNET"
        log "Auto-assigned IP: $CLIENT_VPN_IP"
    fi

    if [[ -z "$SERVER_IP" ]]; then
        SERVER_IP=$(detect_public_ip) || die "Could not detect server IP" "Set SERVER_IP in $QVPN_META and retry."
    fi

    # Read server pubkey from running config (works whether SaveConfig=true or not)
    local server_pub
    server_pub=$(awk '/^[[:space:]]*PrivateKey/ {sub(/^[^=]*=[[:space:]]*/,""); print; exit}' "$WG_CONF" | wg pubkey)
    [[ -z "$server_pub" ]] && die "Could not derive server public key from $WG_CONF"

    section "Adding client '$name'"
    cat <<EOF
  IP:        $CLIENT_VPN_IP
  Endpoint:  $SERVER_IP:${LISTEN_PORT}/udp
  DNS:       $DNS_SERVERS

EOF
    confirm "Add this client?" "y" || die "Aborted by user."

    umask 077
    local client_priv client_pub
    client_priv=$(wg genkey)
    client_pub=$(echo "$client_priv" | wg pubkey)

    cat > "${CLIENTS_DIR}/${name}.conf" <<EOF
[Interface]
PrivateKey = ${client_priv}
Address = ${CLIENT_VPN_IP}/24
DNS = ${DNS_SERVERS}

[Peer]
PublicKey = ${server_pub}
Endpoint = ${SERVER_IP}:${LISTEN_PORT}
AllowedIPs = ${DEFAULT_ALLOWED_IPS}
PersistentKeepalive = ${DEFAULT_KEEPALIVE}
EOF
    chmod 600 "${CLIENTS_DIR}/${name}.conf"

    # Add to running interface (live, no service restart needed)
    log "Registering peer with running WireGuard..."
    run wg set "$WG_INTERFACE" peer "$client_pub" allowed-ips "${CLIENT_VPN_IP}/32"

    # Persist into wg0.conf (SaveConfig=true means wg-quick will preserve on next reload).
    if grep -q "^SaveConfig = true" "$WG_CONF"; then
        run wg-quick save "$WG_INTERFACE"
    else
        cat >> "$WG_CONF" <<EOF

# Client: ${name}
[Peer]
PublicKey = ${client_pub}
AllowedIPs = ${CLIENT_VPN_IP}/32
EOF
    fi

    # Verify
    if wg show "$WG_INTERFACE" peers | grep -q "$client_pub"; then
        ok "Peer is live on $WG_INTERFACE"
    else
        warn "Peer was written but not visible on $WG_INTERFACE yet."
    fi

    section "Client setup — '$name'"
    show_client_payload "${CLIENTS_DIR}/${name}.conf" "$name"

    banner "✓ Client '$name' added"
}

# ─── remove ──────────────────────────────────────────────────────────────────
cmd_remove_help() {
    cat <<EOF
Usage: qvpn remove <name> [-y]

Remove a client from the WireGuard server.

This deletes:
  • ${CLIENTS_DIR}/<name>.conf
  • ${CLIENTS_DIR}/<name>_privatekey
  • ${CLIENTS_DIR}/<name>_publickey
  • ${CLIENTS_DIR}/<name>_qr.png
  • the matching [Peer] block from ${WG_CONF}

Options:
  -y, --yes    Skip confirmation
EOF
}

cmd_remove() {
    local name=""
    while (( $# )); do
        case "$1" in
            -y|--yes)  ASSUME_YES=1; shift ;;
            -h|--help) cmd_remove_help; exit 0 ;;
            -*)        die "Unknown option: $1" "Run: qvpn help remove" ;;
            *)         [[ -z "$name" ]] && name="$1" || die "Unexpected argument: $1"; shift ;;
        esac
    done
    [[ -z "$name" ]] && die "Client name required." "Run: qvpn help remove"

    require_root "remove $name"
    require_setup
    require_cmd wg
    require_wg_running

    local conf="${CLIENTS_DIR}/${name}.conf"
    [[ -f "$conf" ]] || die "Client '$name' not found." "List clients with: qvpn list"

    local pubkey
    pubkey=$(client_pubkey "$conf") || die "Could not derive public key for '$name'."

    confirm "Remove client '$name' and revoke access?" "n" || die "Aborted by user."

    log "Removing peer from running interface..."
    run wg set "$WG_INTERFACE" peer "$pubkey" remove

    if grep -q "^SaveConfig = true" "$WG_CONF"; then
        run wg-quick save "$WG_INTERFACE"
    else
        # Strip the matching [Peer] block from wg0.conf.
        # Algorithm: buffer each [Peer] block; if its PublicKey matches pk, drop it.
        local tmp; tmp=$(mktemp)
        awk -v pk="$pubkey" '
            function flush() {
                if (!in_target && buffered != "") printf "%s", buffered
                buffered = ""; in_target = 0
            }
            /^\[Peer\]/ { flush(); buffered = $0 ORS; next }
            /^\[/       { flush(); print; next }
            /^[[:space:]]*PublicKey/ {
                if (index($0, pk)) in_target = 1
                if (buffered != "") buffered = buffered $0 ORS; else print
                next
            }
            { if (buffered != "") buffered = buffered $0 ORS; else print }
            END { flush() }
        ' "$WG_CONF" > "$tmp"
        run mv "$tmp" "$WG_CONF"
        chmod 600 "$WG_CONF"
    fi

    # Clean up artifacts
    run rm -f "$conf" \
              "${CLIENTS_DIR}/${name}_privatekey" \
              "${CLIENTS_DIR}/${name}_publickey" \
              "${CLIENTS_DIR}/${name}_qr.png"

    ok "Client '$name' removed."
}

# ─── list ────────────────────────────────────────────────────────────────────
cmd_list_help() {
    cat <<EOF
Usage: qvpn list [--json]

List all WireGuard clients (active peers + their config files).
EOF
}

cmd_list() {
    local format=text
    while (( $# )); do
        case "$1" in
            --json)    format=json; shift ;;
            -h|--help) cmd_list_help; exit 0 ;;
            *)         die "Unknown option: $1" "Run: qvpn help list" ;;
        esac
    done

    require_root list
    require_setup

    local peers; peers=$(list_server_peers)
    declare -A pk_to_name=()
    declare -A pk_to_conf=()

    if [[ -d "$CLIENTS_DIR" ]]; then
        for conf in "$CLIENTS_DIR"/*.conf; do
            [[ -e "$conf" ]] || continue
            local pk; pk=$(client_pubkey "$conf" 2>/dev/null) || continue
            local cn; cn=$(basename "$conf" .conf)
            pk_to_name["$pk"]="$cn"
            pk_to_conf["$pk"]="$conf"
        done
    fi

    if [[ "$format" == "json" ]]; then
        local first=1
        printf '['
        while IFS=$'\t' read -r pk ip; do
            [[ -z "$pk" ]] && continue
            (( first )) || printf ','
            first=0
            local nm="${pk_to_name[$pk]:-}"
            printf '{"name":%s,"ip":"%s","pubkey":"%s","has_config":%s}' \
                "$(printf '%s' "$nm" | sed 's/"/\\"/g; s/.*/"&"/')" \
                "$ip" "$pk" \
                "$([[ -n "$nm" ]] && echo true || echo false)"
        done <<<"$peers"
        printf ']\n'
        return 0
    fi

    section "WireGuard clients"
    if [[ -z "$peers" ]]; then
        echo "  (no peers configured yet)"
        echo
        hint "Add one with: qvpn add <name>"
        return 0
    fi

    printf '  %s%-3s %-20s %-15s %s%s\n' "$C_BOLD" "#" "NAME" "VPN IP" "STATUS" "$C_RESET"
    printf '  %s%-3s %-20s %-15s %s%s\n' "$C_DIM" "─" "────" "──────" "──────" "$C_RESET"

    local i=1
    while IFS=$'\t' read -r pk ip; do
        [[ -z "$pk" ]] && continue
        local nm="${pk_to_name[$pk]:-${C_YELLOW}<unknown>${C_RESET}}"
        local status="${C_DIM}configured${C_RESET}"
        if wg show "$WG_INTERFACE" 2>/dev/null | awk -v p="$pk" '
            /^peer:/ { if ($2==p) found=1 }
            /latest handshake:/ { if (found) { print "ok"; exit } }
        ' | grep -q "ok"; then
            status="${C_GREEN}connected${C_RESET}"
        fi
        printf '  %-3s %-20s %-15s %b\n' "$i." "$nm" "$ip" "$status"
        ((i++))
    done <<<"$peers"
    echo
}

# ─── show ────────────────────────────────────────────────────────────────────
cmd_show_help() {
    cat <<EOF
Usage: qvpn show <name> [options]

Display the QR code and config for a client.

Options:
      --qr-only      Print only the QR code
      --conf-only    Print only the .conf text
      --save FILE    Also write the .conf to FILE (e.g. download to laptop)
EOF
}

cmd_show() {
    local name="" qr_only=0 conf_only=0 save_to=""
    while (( $# )); do
        case "$1" in
            --qr-only)   qr_only=1; shift ;;
            --conf-only) conf_only=1; shift ;;
            --save)      save_to="$2"; shift 2 ;;
            -h|--help)   cmd_show_help; exit 0 ;;
            -*)          die "Unknown option: $1" "Run: qvpn help show" ;;
            *)           [[ -z "$name" ]] && name="$1" || die "Unexpected argument: $1"; shift ;;
        esac
    done
    [[ -z "$name" ]] && die "Client name required." "Run: qvpn help show"

    require_root "show $name"
    require_setup

    local conf="${CLIENTS_DIR}/${name}.conf"
    [[ -f "$conf" ]] || die "Client '$name' not found." "List clients with: qvpn list"

    # Confirm peer is in server config
    local pk; pk=$(client_pubkey "$conf") || die "Invalid client config for '$name'."
    if ! grep -q "$pk" "$WG_CONF"; then
        warn "Client '$name' has a config file but is NOT a peer on the server."
        hint "Re-add it with: qvpn add $name --ip $(client_ip_from_conf "$conf")"
    fi

    if [[ -n "$save_to" ]]; then
        cp "$conf" "$save_to"
        ok "Config saved → $save_to"
    fi

    if (( qr_only )); then
        require_cmd qrencode "Install: apt install qrencode"
        qrencode -t ansiutf8 < "$conf"
        return 0
    fi
    if (( conf_only )); then
        cat "$conf"
        return 0
    fi

    banner "Client: $name"
    show_client_payload "$conf" "$name"
}

# ─── status ──────────────────────────────────────────────────────────────────
cmd_status_help() {
    cat <<EOF
Usage: qvpn status

Show WireGuard service health and live peer connection state.
EOF
}

human_bytes() {
    local b=$1
    awk -v b="$b" 'BEGIN {
        split("B KB MB GB TB", u);
        i=1; while (b>=1024 && i<5) { b/=1024; i++ }
        printf (i==1 ? "%d %s" : "%.2f %s"), b, u[i]
    }'
}

human_age() {
    local then="$1"
    [[ -z "$then" || "$then" == 0 ]] && { echo "never"; return; }
    local now diff
    now=$(date +%s)
    diff=$(( now - then ))
    if   (( diff < 60 ));   then echo "${diff}s ago"
    elif (( diff < 3600 )); then echo "$((diff/60))m ago"
    elif (( diff < 86400 ));then echo "$((diff/3600))h ago"
    else echo "$((diff/86400))d ago"
    fi
}

cmd_status() {
    while (( $# )); do
        case "$1" in
            -h|--help) cmd_status_help; exit 0 ;;
            *)         die "Unknown option: $1" "Run: qvpn help status" ;;
        esac
    done

    require_root status
    require_setup
    load_meta

    local active="no" enabled="no"
    systemctl is-active --quiet "wg-quick@${WG_INTERFACE}" && active="yes"
    systemctl is-enabled --quiet "wg-quick@${WG_INTERFACE}" 2>/dev/null && enabled="yes"

    section "Service"
    printf '  %s%-12s%s %s\n' "$C_DIM" "interface:" "$C_RESET" "$WG_INTERFACE"
    printf '  %s%-12s%s %s\n' "$C_DIM" "active:"    "$C_RESET" "$([[ $active == yes ]] && echo "${C_GREEN}yes${C_RESET}" || echo "${C_RED}no${C_RESET}")"
    printf '  %s%-12s%s %s\n' "$C_DIM" "enabled:"   "$C_RESET" "$([[ $enabled == yes ]] && echo "${C_GREEN}yes${C_RESET}" || echo "${C_YELLOW}no${C_RESET}")"
    printf '  %s%-12s%s %s\n' "$C_DIM" "endpoint:"  "$C_RESET" "${SERVER_IP:-?}:${LISTEN_PORT:-?}/udp"
    printf '  %s%-12s%s %s\n' "$C_DIM" "subnet:"    "$C_RESET" "${VPN_SUBNET:-?}"

    if [[ "$active" != "yes" ]]; then
        echo
        warn "WireGuard service is not running."
        hint "Start it with: qvpn restart"
        return 1
    fi

    section "Peers"
    local peers_raw; peers_raw=$(wg show "$WG_INTERFACE" dump 2>/dev/null | tail -n +2)
    if [[ -z "$peers_raw" ]]; then
        echo "  (no peers — add one with: qvpn add <name>)"
        return 0
    fi

    printf '  %s%-20s %-15s %-12s %-12s %s%s\n' "$C_BOLD" "NAME" "VPN IP" "RX" "TX" "HANDSHAKE" "$C_RESET"
    printf '  %s%-20s %-15s %-12s %-12s %s%s\n' "$C_DIM"  "────" "──────" "──" "──" "─────────" "$C_RESET"

    declare -A pk_to_name=()
    if [[ -d "$CLIENTS_DIR" ]]; then
        for conf in "$CLIENTS_DIR"/*.conf; do
            [[ -e "$conf" ]] || continue
            local pk; pk=$(client_pubkey "$conf" 2>/dev/null) || continue
            pk_to_name["$pk"]="$(basename "$conf" .conf)"
        done
    fi

    while IFS=$'\t' read -r pubkey _preshared _endpoint allowed_ips latest_hs rx tx _keepalive; do
        local nm="${pk_to_name[$pubkey]:-<unknown>}"
        local ip="${allowed_ips%%/*}"
        local hs; hs=$(human_age "$latest_hs")
        local color="$C_DIM"
        if [[ -n "$latest_hs" && "$latest_hs" != 0 ]]; then
            local now diff; now=$(date +%s); diff=$((now - latest_hs))
            (( diff < 180 )) && color="$C_GREEN"
        fi
        printf '  %-20s %-15s %-12s %-12s %b%s%b\n' \
            "$nm" "$ip" "$(human_bytes "$rx")" "$(human_bytes "$tx")" "$color" "$hs" "$C_RESET"
    done <<<"$peers_raw"
    echo
}

